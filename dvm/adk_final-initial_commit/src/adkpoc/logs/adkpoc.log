": false\n      },\n      {\n        \"type\": \"dropdown\",\n        \"key\": \"customer_name\",\n        \"name\": \"Customer Name\",\n        \"options\": \"customer_name\",\n        \"isMultiSelect\": true,\n        \"isfirstOptionDefault\": true,\n        \"isQueryParam\": false\n      },\n      {\n        \"type\": \"dropdown\",\n        \"key\": \"aex\",\n        \"name\": \"AEX\",\n        \"options\": \"aex\",\n        \"isMultiSelect\": true,\n        \"isfirstOptionDefault\": true,\n        \"isQueryParam\": false\n      },\n      {\n        \"type\": \"dropdown\",\n        \"key\": \"customer_spec\",\n        \"name\": \"Customer Spec\",\n        \"options\": \"customer_spec\",\n        \"isMultiSelect\": true,\n        \"isfirstOptionDefault\": true,\n        \"isQueryParam\": false\n      }\n    ]\n  },\n  \"pageContent\": [\n    {\n      \"id\": \"row1\",\n      \"columns\": [\n        {\n          \"widget\": {\n            \"apiUrl\": \"/api/v1/highway/grouped-dropdown\",\n            \"class\": \"col-12 col-md-12 col-sm-12 col-lg-12\",\n            \"filterKey\": [\"application_id\"],\n            \"filterListner\": [\"auto\"],\n            \"series\": \"data\",\n            \"title\": \"Opportunity by Segment and Customer\",\n            \"tooltipLabels\": {\n              \"child\": \"Customer Name\",\n              \"parent\": \"Segment\",\n              \"sales\": \"Current Sales $\",\n              \"value\": \"Opportunity $\"\n            },\n            \"triggerFilterEvent\": true,\n            \"type\": \"treemap-chart\",\n            \"useCommaStat\": true,\n            \"useQueryParams\": true,\n            \"widgetId\": \"widget1\",\n            \"xAxisLabel\": \"\",\n            \"yAxisLabel\": \"\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"row2\",\n      \"columns\": [\n        {\n          \"widget\": {\n            \"apiUrl\": \"/api/v1/highway/financial-summary\",\n            \"bgColor\": \"rgb(240, 240, 240