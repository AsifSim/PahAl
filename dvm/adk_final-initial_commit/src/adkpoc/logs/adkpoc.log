ation\": \"right\",\n            \"series\": \"data.value\",\n            \"title\": \"Opportunity ($) by Segment\",\n            \"tooltipLabels\": {\n              \"category\": \"Segment\",\n              \"value\": \"Opportunity $\"\n            },\n            \"triggerFilterEvent\": true,\n            \"type\": \"horizontal-bar-chart\",\n            \"useCommaStat\": true,\n            \"useFormatStat\": true,\n            \"useQueryParams\": true,\n            \"widgetId\": \"widget5\",\n            \"xAxis\": \"data.value\",\n            \"yAxis\": \"data.category\"\n          }\n        },\n        {\n          \"widget\": {\n            \"apiUrl\": \"/api/v1/highway/sales-summary\",\n            \"barColor\": \"#D3D3D3\",\n            \"class\": \"col-6 col-md-6 col-sm-12 col-lg-6\",\n            \"filterKey\": \"application_id\",\n            \"filterListner\": [\"auto\"],\n            \"orientation\": \"right\",\n            \"series\": \"data.value\",\n            \"title\": \"Sales by Segment\",\n            \"tooltipLabels\": {\n              \"category\": \"Segment\",\n              \"value\": \"Sales $\"\n            },\n            \"triggerFilterEvent\": true,\n            \"type\": \"horizontal-bar-chart\",\n            \"useCommaStat\": true,\n            \"useFormatStat\": true,\n            \"useQueryParams\": true,\n            \"widgetId\": \"widget6\",\n            \"xAxis\": \"data.value\",\n            \"yAxis\": \"data.category\"\n          }\n        }\n      ]\n    }\n  ]\n}\n```"}],"role":"model"}
