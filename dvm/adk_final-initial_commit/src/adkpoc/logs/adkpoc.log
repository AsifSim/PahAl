ial-summary\",\n          \"prefix\": \"$\",\n          \"useFormatStat\": true,\n          \"useQueryParams\": true\n        },\n        {\n          \"widgetId\": \"widget3\",\n          \"type\": \"number-stats\",\n          \"key\": \"opportunity_percent\",\n          \"parentKey\": \"opportunity_percent\",\n          \"value\": \"data\",\n          \"title\": \"Opportunity (%)\",\n          \"class\": \"col-12 col-sm-6 col-md-4 col-lg-4\",\n          \"bgColor\": \"rgb(240, 240, 240)\",\n          \"apiUrl\": \"http://localhost:8085/api/v1/highway/financial-summary\",\n          \"prefix\": \"$\",\n          \"useFormatStat\": true,\n          \"useQueryParams\": true\n        }\n      ]\n    },\n    {\n      \"id\": \"row2\",\n      \"columns\": [\n        {\n          \"widgetId\": \"widget4\",\n          \"type\": \"treemap-chart\",\n          \"title\": \"Opportunity by Segment and Customer\",\n          \"class\": \"col-12 col-sm-12 col-md-12 col-lg-12\",\n          \"apiUrl\": \"http://localhost:8085/api/v1/highway/grouped-dropdown\",\n          \"series\": \"data\",\n          \"useQueryParams\": true,\n          \"useCommaStat\": true,\n          \"triggerFilterEvent\": true,\n          \"filterKey\": [\n            \"application_id\"\n          ],\n          \"filterListner\": [\n            \"auto\"\n          ],\n          \"tooltipLabels\": {\n            \"parent\": \"Segment\",\n            \"child\": \"Customer Name\",\n            \"value\": \"Opportunity $\",\n            \"sales\": \"Current Sales $\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"row3\",\n      \"columns\": [\n        {\n          \"widgetId\": \"widget5\",\n          \"type\": \"horizontal-bar-chart\",\n          \"title\": \"Opportunity($) by Segment\",\n          \"class\": \"col-12 col-sm-12 col-md-6 col-lg-6\",\n          \"apiUrl\": \"http://localhost:8085/api/v1/highway/opportunity-summary\",\n          \"xAxis\": \"data.value\",\n          \"yAxis\":