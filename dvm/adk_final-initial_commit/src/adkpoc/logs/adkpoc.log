istner\": [\n                \"auto\"\n              ],\n              \"orientation\": \"right\",\n              \"series\": \"data.value\",\n              \"title\": \"Sales\",\n              \"tooltipLabels\": {\n                \"category\": \"Segment\",\n                \"value\": \"Sales $\"\n              },\n              \"triggerFilterEvent\": true,\n              \"type\": \"horizontal-bar-chart\",\n              \"useCommaStat\": true,\n              \"useFormatStat\": true,\n              \"useQueryParams\": true,\n              \"widgetId\": \"widget6\",\n              \"xAxis\": \"data.value\",\n              \"yAxis\": \"data.category\"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}\n```"}],"role":"model"}
